<?xml version="1.0"?>
<robot name="lightbulb_1dof_realbulb">

  <!--
    Real-size lightbulb asset for sim2real checks.

    Source mesh full bounding box:
      length along mesh +X: about 110.46 mm
      max diameter: about 62.03 mm

    Target real bulb:
      height/length: about 140 mm
      max diameter: about 60 mm

    The meshes are rotated so original +X becomes world +Z. Visual and
    collision geometry intentionally use the same contact meshes so the Isaac
    Gym viewer shows the actual contact surface.
  -->

  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.40 0.40 0.40 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="bolt">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_to_bolt" type="fixed">
    <parent link="base"/>
    <child link="bolt"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <link name="nut">
    <visual>
      <origin xyz="0 0 0.074972" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="../../lightbulb/contact0.stl" scale="1.253716 0.950585 0.950585"/>
      </geometry>
      <material name="contact_head_white">
        <color rgba="0.92 0.92 0.92 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.074972" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="../../lightbulb/contact1.stl" scale="1.253716 0.950585 0.950585"/>
      </geometry>
      <material name="contact_socket_gray">
        <color rgba="0.50 0.50 0.50 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.074972" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="../../lightbulb/contact0.stl" scale="1.253716 0.950585 0.950585"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.074972" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="../../lightbulb/contact1.stl" scale="1.253716 0.950585 0.950585"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="9e-5" ixy="0" ixz="0" iyy="9e-5" iyz="0" izz="2.5e-5"/>
    </inertial>
  </link>

  <joint name="bolt_to_nut" type="revolute">
    <parent link="bolt"/>
    <child link="nut"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <dynamics friction="0.2"/>
    <limit lower="0.0" upper="628.3185" effort="2.0" velocity="6.2832"/>
  </joint>

</robot>
